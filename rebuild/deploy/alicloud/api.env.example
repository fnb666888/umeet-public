# Copy to /etc/umeet/api.env using mode 0600 after a new database is chosen.
# A MySQL 8 database/schema must already exist. Do not commit real values.
NODE_ENV=production
HOST=127.0.0.1
PORT=3188
DATABASE_URL=mysql://APP_USER:URL_ENCODED_PASSWORD@DATABASE_HOST:3306/DATABASE_NAME
PUBLIC_WEB_ORIGIN=https://YOUR_DOMAIN
EMAIL_OTP_ENABLED=false
SMS_OTP_PROVIDER=disabled
# For TiDB Cloud use port 4000 and append ?ssl=true. Full username prefix is required.
# Leave AI disabled until an approved production provider is configured.
INTEREST_AI_ENABLED=false
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=example.com
ASSET_STORAGE=database
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Cloudflare Workers Free: do not upgrade automatically.
INTEREST_AI_PROVIDER=cloudflare
INTEREST_AI_FREE_ONLY_ACK=false
INTEREST_AI_HOSTS=api.cloudflare.com
INTEREST_AI_URL=
INTEREST_AI_MODEL=
INTEREST_AI_KEY=
