{
  "name": "umeet-rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "bundle:demo-ui": "node scripts/bundle-demo-ui.mjs",
    "test": "vitest run",
    "test:contracts": "vitest run packages/contracts/test",
    "test:knowledge": "vitest run packages/contracts/test/knowledge.test.ts apps/api/test/knowledge.int.test.ts apps/web/test/knowledge-editor.test.tsx apps/web/test/knowledge-render.test.tsx",
    "e2e:accounts": "python tests/web/browser-accounts.py",
    "e2e:knowledge": "python tests/web/knowledge.py",
    "fixture:knowledge": "node --import tsx tests/web/knowledge-fixtures.ts",
    "accounts:local": "node --import tsx scripts/setup-local-role-accounts.ts",
    "preview:knowledge": "node scripts/run-knowledge-preview.mjs",
    "test:markdown": "vitest run packages/markdown/test probes/editor",
    "test:api": "vitest run apps/api/test",
    "test:web": "vitest run apps/web/test",
    "e2e:web": "python tests/web/run.py",
    "e2e:web:otp": "python tests/web/otp.py",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@umeet/web",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:web": "npm run build --workspace=@umeet/web",
    "check": "npm run typecheck && npm test",
    "verify:capabilities": "node scripts/verify-capabilities.mjs",
    "db:migrate:test": "tsx apps/api/test/support/migrate-test.ts",
    "auth:check": "tsx scripts/check-auth-config.ts",
    "admin:grant": "tsx scripts/grant-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@mathjax/src": "4.1.3",
    "@milkdown/kit": "7.23.0",
    "@milkdown/react": "7.23.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "kysely": "0.28.19",
    "lucide-react": "1.70.0",
    "mysql2": "3.24.6",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "parse5": "8.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "reflect-metadata": "0.2.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "rxjs": "7.8.2",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "tencentcloud-sdk-nodejs-sms": "4.1.306",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "27.0.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "6.0.3",
    "@types/unist": "3.0.3",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "smtp-server": "3.21.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "multer": "2.5.0",
    "katex": "0.18.2",
    "tencentcloud-sdk-nodejs-common": {
      "uuid": "11.1.1"
    }
  },
  "license": "0BSD"
}
