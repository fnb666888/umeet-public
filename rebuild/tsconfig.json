{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "rewriteRelativeImportExtensions": true,
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "lib": ["ES2023", "DOM"], "types": ["node"], "outDir": "dist"
  },
  "include": ["packages/**/*.ts", "apps/api/**/*.ts", "probes/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "apps/miniprogram"]
}
