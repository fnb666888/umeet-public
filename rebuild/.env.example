# Local development instance only. Use dedicated, least-privilege credentials in production.
DATABASE_URL=mysql://root@127.0.0.1:19316/umeet_rebuild_local
PORT=3188
# Next.js server only, never expose a database or session secret in NEXT_PUBLIC_*.
API_BASE_URL=http://127.0.0.1:3188/api/v1
PUBLIC_WEB_ORIGIN=http://127.0.0.1:5178
# Optional native WeChat login. Set both only in server secrets/configuration.
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
# Only set after verifying that website/mini applications share this Open Platform account.
WECHAT_OPEN_PLATFORM_REALM=

# OTP delivery is explicitly disabled until real service credentials are configured.
EMAIL_OTP_ENABLED=false
SMS_OTP_PROVIDER=disabled
# Separate 32-byte random secret, encoded as 64 hex characters; server only.
OTP_HASH_KEY=
OTP_EMAIL_DAILY_LIMIT=200
OTP_SMS_DAILY_LIMIT=20
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional sender adapter; does not change the WeChat Cloud Hosting deployment.
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_PARAMETERS=code
TENCENT_SMS_INTERNATIONAL_TEMPLATE_ID=
TENCENT_SMS_INTERNATIONAL_SIGN_NAME=
TENCENT_SMS_SENDER_ID=
