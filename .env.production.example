# 复制到 .env.production，填写真实服务配置。数据库/Redis 密码建议随机十六进制，避免 URL 转义问题。
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
ADMIN_PASSWORD=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
PUBLIC_API_URL=https://example.com
CORS_ORIGINS=https://example.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
WECHAT_SUBSCRIBE_TEMPLATE=
# 根据实际已申请模板填写；需对应两项文本及一项时间字段，不能直接沿用示例字段编号。
WECHAT_SUBSCRIBE_FIELD_MAP=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
VERIFICATION_RETENTION_DAYS=7
GATEWAY_PORT=8080
