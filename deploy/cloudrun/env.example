# 复制为项目根目录 .env.wxcloud。这个文件中的占位值不能用于部署。
# 云托管控制台专用 CLI 密钥；不是 AppSecret，也不是代码上传私钥文件。
WXCLOUD_CLI_KEY=
WXCLOUD_APP_ID=YOUR_WECHAT_APP_ID
WXCLOUD_ENV_ID=
WXCLOUD_SERVICE_NAME=example-api
WXCLOUD_REGION=ap-shanghai
DATABASE_URL=
DATABASE_PROVIDER=mysql
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=umeet
MYSQL_USER=root
MYSQL_PASSWORD=
DATABASE_POOL_SIZE=5
TASK_TRANSPORT=database
REDIS_URL=
JWT_SECRET=
ADMIN_PASSWORD=
WECHAT_APP_ID=YOUR_WECHAT_APP_ID
WECHAT_APP_SECRET=
STORAGE_PROVIDER=wxcloud-cos
COS_BUCKET=
COS_REGION=ap-shanghai
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
PUBLIC_API_URL=https://example.com
CORS_ORIGINS=https://example.com
VERIFICATION_RETENTION_DAYS=7
# 如需邮件认证与微信订阅，填写以下可选配置。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WECHAT_SUBSCRIBE_TEMPLATE=
WECHAT_SUBSCRIBE_FIELD_MAP=
