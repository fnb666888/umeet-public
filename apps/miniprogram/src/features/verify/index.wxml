<view class="page"><view class="eyebrow">A COMMUNITY BUILT ON TRUST</view><view class="title">你的校园身份，<view>你的社区归属。</view></view><view class="subtitle">{{schoolName}}</view><view class="notice" style="margin:30rpx 0">仅提交核验学校归属所需的信息，请遮挡无关姓名、学号或证件号。材料使用私有权限保存。</view><view wx:if="{{verified}}" class="card"><view class="row between"><view>校园认证已通过</view><text class="pill">已认证 ✓</text></view><view class="subtitle">有效期至 {{expires}}</view></view><block wx:else><view class="card"><view class="block-title">学校邮箱认证</view><view class="field"><input value="{{email}}" data-field="email" bindinput="input" placeholder="输入学校认证邮箱"/></view><button class="outline" bindtap="sendCode" disabled="{{busy}}">发送验证码</button><view wx:if="{{requestId}}" class="field" style="margin-top:20rpx"><input value="{{code}}" type="number" data-field="code" bindinput="input" maxlength="6" placeholder="六位验证码"/><button class="primary" bindtap="confirm" style="margin-top:20rpx">确认验证</button></view><view class="caption" style="margin-top:20rpx">学校未配置邮箱服务时，请选择材料审核。</view></view><view class="card"><view class="block-title">人工材料认证</view><button class="outline" bindtap="choose">{{image?'重新选择':'选择认证材料'}}</button><image wx:if="{{image}}" src="{{image}}" mode="widthFix" style="width:100%;margin-top:20rpx;border-radius:15rpx"/><button class="primary" bindtap="manual" loading="{{busy}}" disabled="{{busy}}" style="margin-top:20rpx">提交材料审核</button></view></block><view class="block-title">申请记录</view><view wx:for="{{requests}}" wx:key="id" class="card"><view class="row between"><text>{{item.method==='EMAIL'?'邮箱认证':'材料认证'}}</text><text class="pill">{{item.statusName}}</text></view><view class="subtitle">{{item.reason||'认证申请已记录'}}</view><view class="caption">{{item.time}}</view></view><view wx:if="{{!requests.length}}" class="empty">尚无申请记录</view></view>
